# ==============================================================================
# ORAVI MODEL & WARD SYNC CONFIGURATION (.env)
# ==============================================================================
# This file controls which AI model Oravi connects to for natural language queries.
# Because Oravi uses the universal OpenAI-compatible chat API protocol,
# you can switch providers at any time without changing a single line of code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL OLLAMA (Default — 100% On-Premise Hospital Server)
# ------------------------------------------------------------------------------
# Requires Ollama running locally: ollama run qwen2.5:7b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b
LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI (Cloud testing with Gemini API key)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-1.5-flash
# LLM_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OPENAI / AZURE OPENAI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=your_openai_key_here

# ------------------------------------------------------------------------------
# 4. LIVEKIT CALLING
# ------------------------------------------------------------------------------
# The API server keeps the LiveKit API key and secret private.
# LIVEKIT_URL=https://your-livekit-host.example.com
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 5. ELEVENLABS AI SCRIBE (Clinical Ritual audio transcription)
# ------------------------------------------------------------------------------
# The API server keeps this key private. Use ElevenLabs Scribe for transcription;
# structured summary generation can be handled by the configured LLM provider.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_SCRIBE_MODEL=scribe_v3

# ------------------------------------------------------------------------------
# 6. LIVEKIT EGRESS RECORDING (server-side object storage)
# ------------------------------------------------------------------------------
# The backend starts audio-only Egress; clinician devices never save recordings.
# ORAVI_PUBLIC_URL=https://oravi.example.com
# Use the Firebase/Google Cloud Storage bucket created for this project.
# LIVEKIT_EGRESS_GCS_BUCKET=your-project.firebasestorage.app
# Reuse the protected Firebase Admin service-account file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\oravi\firebase-service-account.json
# Alternatively, provide the JSON through a protected secret:
# LIVEKIT_EGRESS_GCP_CREDENTIALS={"type":"service_account",...}
