# ==============================================================================
# ORAVI MODEL & WARD SYNC CONFIGURATION (.env)
# ==============================================================================
# This file controls which AI model Oravi connects to for natural language queries.
# Because Oravi uses the universal OpenAI-compatible chat API protocol,
# you can switch providers at any time without changing a single line of code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL OLLAMA (Default — 100% On-Premise Hospital Server)
# ------------------------------------------------------------------------------
# Requires Ollama running locally: ollama run qwen2.5:7b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b
LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI (Cloud testing with Gemini API key)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-1.5-flash
# LLM_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OPENAI / AZURE OPENAI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=your_openai_key_here

# ------------------------------------------------------------------------------
# LIVEKIT CALLING
# ------------------------------------------------------------------------------
# The API server keeps the LiveKit API key and secret private.
# LIVEKIT_URL=https://your-livekit-host.example.com
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# For the local Docker stack, Compose supplies these values:
# LIVEKIT_INTERNAL_URL=http://livekit:7880
# LIVEKIT_PUBLIC_URL=ws://192.168.1.25:7880

# ------------------------------------------------------------------------------
# ELEVENLABS AI SCRIBE (Clinical Ritual audio transcription)
# ------------------------------------------------------------------------------
# The API server keeps this key private. Structured summary generation uses the
# configured LLM provider after the transcript is saved.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_SCRIBE_MODEL=scribe_v3

# ------------------------------------------------------------------------------
# LIVEKIT EGRESS RECORDING (server-side Google Cloud Storage)
# ------------------------------------------------------------------------------
# The backend starts audio-only Egress; clinician devices never save recordings.
# This must be the public HTTPS URL of the deployed backend.
# ORAVI_PUBLIC_URL=https://oravi.example.com
# Use the Firebase/Google Cloud Storage bucket created for this project.
# LIVEKIT_EGRESS_GCS_BUCKET=your-project.firebasestorage.app
# Reuse the protected Firebase Admin service-account file:
# GOOGLE_APPLICATION_CREDENTIALS=D:\secure\oravi\firebase-service-account.json
# Alternatively, provide the JSON through a protected secret:
# LIVEKIT_EGRESS_GCP_CREDENTIALS={"type":"service_account",...}

# ------------------------------------------------------------------------------
# LOCAL TRANSCRIPTION (development residency mode)
# ------------------------------------------------------------------------------
# Compose supplies these values for the local Docker stack. The first model
# download is large and is cached by faster-whisper on the backend host.
# TRANSCRIPTION_PROVIDER=whisper_local
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (backend only)
# ------------------------------------------------------------------------------
# Firebase client configuration belongs in the Flutter platform files.
FIREBASE_PROJECT_ID=oravi-main
# Prefer a protected credential file for local development. Do not commit it.
# GOOGLE_APPLICATION_CREDENTIALS=D:\secure\oravi\firebase-service-account.json
# Alternatively, use FIREBASE_SERVICE_ACCOUNT_JSON from a secret manager.
