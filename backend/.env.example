# ==============================================================================
# ORAVI MODEL & WARD SYNC CONFIGURATION (.env)
# ==============================================================================
# This file controls which AI model Oravi connects to for natural language queries.
# Because Oravi uses the universal OpenAI-compatible chat API protocol,
# you can switch providers at any time without changing a single line of code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL OLLAMA (Default — 100% On-Premise Hospital Server)
# ------------------------------------------------------------------------------
# Requires Ollama running locally: ollama run qwen2.5:7b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b
LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI (Cloud testing with Gemini API key)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-1.5-flash
# LLM_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OPENAI / AZURE OPENAI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=your_openai_key_here
